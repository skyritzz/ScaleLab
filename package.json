{
  "name": "url-shortener-simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive System Design & Distributed Architecture Simulator for URL Shortener",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/index.js",
    "dev:all": "concurrently -n \"backend,frontend\" -c \"magenta,cyan\" \"npm run server\" \"npm run dev\"",
    "db:migrate": "node -e \"import('./server/db.js').then(m => m.runMigrations()).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "build": "vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ioredis": "^6.0.0",
    "lucide": "^0.475.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "pino-pretty": "^13.1.3",
    "vite": "^6.2.0"
  },
  "keywords": [
    "system-design",
    "distributed-systems",
    "url-shortener",
    "simulator",
    "architecture",
    "education",
    "caching",
    "bottlenecks"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
