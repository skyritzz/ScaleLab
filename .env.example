# ==============================================================================
# sho.rt URL Shortener - Environment Configuration
# ==============================================================================

# Server / Base URL Configuration
PORT=4000
HOST=0.0.0.0

# Base URL used for generated short URLs
# - Local dev: http://localhost:4000 (or http://localhost:3000)
# - Production (Vercel): https://your-domain.vercel.app
BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL)
# - Local Docker: postgresql://shortener:shortener_secret@localhost:5432/shortener
# - Production (Neon): postgresql://<user>:<password>@<neon-host>/neondb?sslmode=require
DATABASE_URL=postgresql://shortener:shortener_secret@localhost:5432/shortener

# Cache Configuration (Redis)
# - Local Docker: redis://localhost:6379
# - Production (Upstash): rediss://default:<password>@<upstash-host>:6379
REDIS_URL=redis://localhost:6379

# Node Environment ('development' or 'production')
NODE_ENV=development
